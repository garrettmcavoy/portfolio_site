---
import Layout from '../layouts/Layout.astro';
import GalleryPhoto from '../components/GalleryPhoto.astro';
import { photoYears } from '../data/photography';
---
<Layout title="Photography · Garrett McAvoy" description="Selected photography by Garrett McAvoy, organized by year.">
  <div class="photography-container">
    <h1 class="sr-only">Photography</h1>
    {photoYears.map(({ year, photos }, yearIndex) => (
      <section class="year-section" aria-labelledby={`year-${year}`}>
        <h2 class="year-title" id={`year-${year}`}>{year}</h2>
        <div class="photo-scroll" tabindex="0" role="region" aria-label={`${year} photographs — scroll horizontally to explore`}>
          {photos.map((path, index) => <GalleryPhoto path={path} year={year} index={index} priority={yearIndex === 0 && index === 0} />)}
        </div>
      </section>
    ))}
  </div>
  <dialog class="lightbox" aria-label="Enlarged photograph" data-lightbox>
    <button type="button" class="lightbox-close" aria-label="Close photograph" autofocus>×</button>
    <img class="lightbox-image" alt="" decoding="async" />
  </dialog>
</Layout>

<script>
  import '../scripts/gallery';
</script>

<style>
  .photography-container { --photo-height: 400px; width: 100%; min-width: 0; display: flex; flex-direction: column; gap: 2rem; padding-bottom: 5rem; }
  .year-section { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .year-title { font-size: 1rem; font-weight: bold; }
  .photo-scroll { display: flex; align-items: flex-start; gap: 1rem; overflow-x: auto; padding-bottom: .5rem; padding-inline-end: 1rem; scroll-padding-inline-end: 1rem; scroll-snap-type: x proximity; scrollbar-width: thin; }
  .lightbox { position: fixed; inset: 0; margin: auto; padding: 0; border: 0; width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; background: transparent; overflow: hidden; }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgb(0 0 0 / .88); }
  .lightbox-image { display: block; max-width: 90vw; max-height: 86dvh; width: auto; height: auto; object-fit: contain; cursor: zoom-out; }
  .lightbox-close { appearance: none; -webkit-appearance: none; box-shadow: none; border-radius: 0; position: absolute; top: .5rem; right: 1rem; width: 44px; height: 44px; border: 0; background: transparent; color: white; font: 2rem/1 sans-serif; cursor: pointer; }
  @media (max-width: 768px) {
    .photography-container { --photo-height: 300px; }
    /* The viewport reaches both screen edges; the inset travels with the photos. */
    .photo-scroll {
      width: calc(100% + 2rem);
      margin-inline: -1rem;
      padding-inline: 1rem;
      scroll-padding-inline: 1rem;
    }
  }
</style>
