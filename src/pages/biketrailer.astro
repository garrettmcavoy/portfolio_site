---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
const images = [
  ['finalproduct.jpg', 'Final product'],
  ['feasetup.png', 'FEA Setup'],
  ['maxdeflection.png', 'Maximum Deflection'],
  ['maxstress.png', 'Maximum Stress'],
  ['measurement_node.png', 'Measurement Point'],
  ['verificationdeflection.png', 'Member used for hand validation — deflection'],
  ['verificationstress.png', 'Member used for hand validation — stress'],
  ['feaverification.jpg', 'Member used for hand validation'],
] as const;
---
<ProjectLayout title="Bike Trailer" heading="ME 328 - Bike Trailer">
  <div class="images">
    {images.map(([file, alt], index) => <OptimizedImage source={`bike_trailer/${file}`} alt={alt} loading={index === 0 ? 'eager' : 'lazy'} />)}
  </div>
</ProjectLayout>
