---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Other · Garrett McAvoy">
    <div class="animation-container">
        <iframe 
            src="https://garrettmcavoy.github.io/murex/" 
            title="Murex Animation"
            class="animation-frame"
            loading="lazy">
        </iframe>
    </div>
</Layout>

<style>
    .animation-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: min(100%, 80vh);
        height: 70vh;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 15px;
        background-color: #f0f0f0;
    }

    .animation-frame {
        width: 100%;
        height: 100%;
        border: none;
        border-radius: inherit;
    }

    @media (min-width: 769px) and (orientation: landscape) {
        .animation-container {
            position: absolute;
            inset: 0;
            width: min(80dvh, calc(100vw - 2rem));
            height: 70dvh;
            margin: auto;
        }
    }
</style>
