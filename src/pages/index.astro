---
import Layout from '../layouts/Layout.astro';
import Aquarium from '../components/Aquarium.astro';
---

<Layout title="Garrett McAvoy" immersive>
  <div class="home-scene">
    <h1 class="sr-only">Garrett McAvoy</h1>
    <Aquarium />
  </div>
</Layout>

<style>
  .home-scene {
    /* Safari fills fixed layers' browser edges with solid color. Keep the
       scene in document flow so its native scroll-edge effect can sample it. */
    position: relative;
    width: 100%;
    height: 100dvh;
    /* Begin at Safari's drawable top edge and end at the physical bottom,
       including the scene behind its bottom controls. */
    height: max(100lvh, var(--aquarium-screen-height, 0px));
  }
</style>
