---
import { Image, getImage } from 'astro:assets';
import { imageSource, imageWidths } from '../lib/images';

interface Props {
  path: string;
  year: string;
  index: number;
  priority?: boolean;
}

const { path, year, index, priority = false } = Astro.props;
const source = await imageSource(path);
const ratio = source.width / source.height;
const alt = `Photograph ${index + 1} from ${year} by Garrett McAvoy`;
const sizes = `(max-width: 768px) min(${Math.round(300 * ratio)}px, calc(100vw - 2rem)), ${Math.round(400 * ratio)}px`;
const widths = imageWidths(source, [Math.round(300 * ratio), Math.round(400 * ratio), Math.round(600 * ratio), Math.round(800 * ratio)]);
const enlarged = await Promise.all(imageWidths(source, [1280, 1920, 2560]).map(width => getImage({ src: source, width, format: 'webp', quality: 88 })));
const fullSrc = enlarged.at(-1)!.src;
const fullSrcset = enlarged.map(image => `${image.src} ${image.options.width}w`).join(', ');
const imageProps = { src: source, alt, widths, sizes, format: 'webp' as const, quality: 82, decoding: 'async' as const };
---
<a
  class="photo-link"
  href={fullSrc}
  data-photo
  data-full-srcset={fullSrcset}
  data-alt={alt}
  data-width={source.width}
  data-height={source.height}
  aria-label={`Enlarge ${alt.toLowerCase()}`}
  style={`--photo-ratio: ${ratio}`}
>
  {priority ? <Image {...imageProps} loading="eager" fetchpriority="high" /> : (
    <>
      <template data-photo-image><Image {...imageProps} loading="eager" /></template>
      <noscript><Image {...imageProps} loading="lazy" /></noscript>
    </>
  )}
</a>

<style>
  .photo-link {
    flex: 0 0 auto;
    display: block;
    width: calc(var(--photo-height) * var(--photo-ratio));
    max-width: 100%;
    aspect-ratio: var(--photo-ratio);
    align-self: flex-start;
    background: rgb(214, 214, 210);
    scroll-snap-align: start;
    cursor: zoom-in;
  }
  .photo-link :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
</style>
