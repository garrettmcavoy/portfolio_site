---
interface Props {
  title: string;
  items: { name: string; href: string }[];
  currentPath: string;
}
const { title, items, currentPath } = Astro.props;
const active = items.some(item => currentPath === item.href.replace(/\/$/, ''));
---
<li class="dropdown">
  <details class:list={{ active }}>
    <summary>{title}</summary>
    <div class="dropdown-reveal">
      <ul class="dropdown-menu">
        {items.map(item => <li><a href={item.href} aria-current={currentPath === item.href.replace(/\/$/, '') ? 'page' : undefined}>{item.name}</a></li>)}
      </ul>
    </div>
  </details>
</li>

<script>
  import '../scripts/dropdown';
</script>
