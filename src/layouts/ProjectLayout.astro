---
import Layout from './Layout.astro';
interface Props { title: string; heading: string; }
const { title, heading } = Astro.props;
---
<Layout title={`${title} · Garrett McAvoy`}>
  <article class="project">
    <h1>{heading}</h1>
    <slot />
  </article>
</Layout>
<style>
  .project { width: min(100%, 900px); margin-right: 200px; padding-bottom: 3rem; }
  h1 { font-size: 1rem; margin-bottom: 1rem; }
  .project :global(p), .project :global(ol) { line-height: 1.6; margin-bottom: 1rem; }
  .project :global(ol) { padding-left: 1.5rem; }
  .project :global(.images) { display: flex; flex-direction: column; gap: 1rem; }
  .project :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 768px) { .project { margin-right: 0; } }
</style>
