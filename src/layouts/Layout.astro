---
import font from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import Dropdown from '../components/Dropdown.astro';
import { backgroundColors } from '../scripts/aquarium-backgrounds';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}
const { title, description = 'Photography, engineering projects, and work by Garrett McAvoy.', immersive = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class:list={{ 'aquarium-root': immersive }} style={immersive ? `--aquarium-chrome:${backgroundColors.classic}` : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={`width=device-width, initial-scale=1.0${immersive ? ', viewport-fit=cover' : ''}`} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={immersive ? backgroundColors.classic : '#e5e5e1'} />
    {immersive && <script is:inline define:vars={{ backgroundColors }}>
      // Restore the bar color before the first paint or aquarium asset loading.
      try {
        const saved = JSON.parse(localStorage.getItem('portfolio-aquarium-settings') || '{}');
        if (Object.hasOwn(backgroundColors, saved.background)) {
          const color = backgroundColors[saved.background];
          document.documentElement.style.setProperty('--aquarium-chrome', color);
          document.querySelector('meta[name="theme-color"]').content = color;
        }
      } catch { /* Optional storage; keep the default reef color. */ }
    </script>}
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'aquarium-home': immersive }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="layout-container">
      <aside class="sidebar">
        <div class="site-title"><a href="/">Garrett McAvoy</a></div>
        <nav aria-label="Main navigation">
          <ul>
            <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
            <Dropdown title="Portfolio" currentPath={currentPath} items={[{ name: 'Photography', href: '/photography/' }, { name: 'Other', href: '/other/' }]} />
            <li><a href="/cv/" aria-current={currentPath === '/cv' ? 'page' : undefined}>CV</a></li>
          </ul>
        </nav>
      </aside>
      <main id="main" class="main-content" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
