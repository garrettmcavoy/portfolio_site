---
import font from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import Dropdown from '../components/Dropdown.astro';
import { backgroundColors } from '../scripts/aquarium-backgrounds';
import { iphoneTopInsets } from '../scripts/aquarium-display';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}
const { title, description = 'Photography, engineering projects, and work by Garrett McAvoy.', immersive = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" class:list={{ 'aquarium-root': immersive }} style={immersive ? `--aquarium-chrome:${backgroundColors.classic}` : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={`width=device-width, initial-scale=1.0${immersive ? ', viewport-fit=cover' : ''}`} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={immersive ? backgroundColors.classic : '#e5e5e1'} />
    {immersive && <script is:inline define:vars={{ backgroundColors }}>
      // Restore the bar color before the first paint or aquarium asset loading.
      try {
        const saved = JSON.parse(localStorage.getItem('portfolio-aquarium-settings') || '{}');
        if (Object.hasOwn(backgroundColors, saved.background)) {
          const color = backgroundColors[saved.background];
          document.documentElement.style.setProperty('--aquarium-chrome', color);
          document.querySelector('meta[name="theme-color"]').content = color;
        }
      } catch { /* Optional storage; keep the default reef color. */ }
    </script>}
    {immersive && <script is:inline define:vars={{ iphoneTopInsets }}>
      // Some iPhone Safari layouts report zero safe areas and a 100lvh that
      // stops inside the toolbar. Cover the display below its system top edge.
      // Restrict this to phones: an iPad window can occupy part of its screen.
      if (/iPhone|iPod/.test(navigator.userAgent)) {
        const updateAquariumScreen = () => {
          const landscape = matchMedia('(orientation: landscape)').matches;
          const shortSide = Math.min(screen.width, screen.height);
          const longSide = Math.max(screen.width, screen.height);
          const screenWidth = landscape ? longSide : shortSide;
          const screenHeight = landscape ? shortSide : longSide;
          // Browser page zoom changes CSS pixels; pinch zoom doesn't change
          // the layout viewport and should not resize the aquarium.
          const layoutWidth = document.documentElement.clientWidth || innerWidth;
          if (screenWidth > 0 && layoutWidth > 0) {
            const scale = layoutWidth / screenWidth;
            const root = document.documentElement;
            // Read actual padding: some Safari versions return zero when
            // environment variables are read through CSS custom properties.
            const probe = document.querySelector('[data-aquarium-safe-area]');
            const style = probe ? getComputedStyle(probe) : null;
            const safeTop = parseFloat(style?.paddingTop || '0') || 0;
            const maxSafeTop = parseFloat(style?.paddingBottom || '0') || 0;
            const displayKey = `${shortSide}x${longSide}`;
            // XR/11 and XS Max/11 Pro Max share a screen size, but have
            // different pixel densities and system top regions.
            const fallbackTop = displayKey === '414x896' && devicePixelRatio === 2
              ? 48 : iphoneTopInsets[displayKey];
            const systemTop = maxSafeTop > 0 ? maxSafeTop / scale : fallbackTop;
            // A positive current inset means the top region is already inside
            // the page. Landscape and full-height views need no subtraction.
            const topIsExcluded = !landscape && safeTop === 0
              && innerHeight / scale < screenHeight - 1;
            if (topIsExcluded && systemTop === undefined) {
              // For unfamiliar displays, keep Safari's own viewport sizing
              // until it supplies a usable inset instead of guessing pixels.
              root.style.removeProperty('--aquarium-screen-height');
              return;
            }
            const excludedTop = topIsExcluded ? systemTop : 0;
            document.documentElement.style.setProperty('--aquarium-screen-height', `${(screenHeight - excludedTop) * scale}px`);
          }
        };
        updateAquariumScreen();
        document.addEventListener('DOMContentLoaded', updateAquariumScreen, { once: true });
        window.addEventListener('resize', updateAquariumScreen);
        window.addEventListener('orientationchange', updateAquariumScreen);
        window.addEventListener('pageshow', updateAquariumScreen);
      }
    </script>}
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'aquarium-home': immersive }}>
    {immersive && <div class="aquarium-safe-area-probe" data-aquarium-safe-area aria-hidden="true"></div>}
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="layout-container">
      <aside class="sidebar">
        <div class="site-title"><a href="/">Garrett McAvoy</a></div>
        <nav aria-label="Main navigation">
          <ul>
            <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
            <Dropdown title="Portfolio" currentPath={currentPath} items={[{ name: 'Photography', href: '/photography/' }, { name: 'Other', href: '/other/' }]} />
            <li><a href="/cv/" aria-current={currentPath === '/cv' ? 'page' : undefined}>CV</a></li>
          </ul>
        </nav>
      </aside>
      <main id="main" class="main-content" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
